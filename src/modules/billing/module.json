{
  "id": "billing",
  "name": "Stripe billing",
  "description": "Checkout, subscriptions, customer portal and verified webhooks",
  "paths": [
    "src/modules/billing",
    "src/app/api/billing",
    "src/app/(dashboard)/dashboard/billing",
    "src/app/(dashboard)/admin/billing",
    "src/app/(marketing)/pricing",
    "tests/e2e/billing.spec.ts"
  ],
  "prismaFiles": [
    "prisma/schema/billing.prisma"
  ],
  "packages": [
    "stripe",
    "@stripe/stripe-js",
    "@stripe/react-stripe-js"
  ],
  "envKeys": [
    "STRIPE_SECRET_KEY",
    "STRIPE_WEBHOOK_SECRET",
    "NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY"
  ],
  "dependsOn": []
}
