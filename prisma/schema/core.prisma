model AppRateLimit {
  id      String   @id @default(cuid())
  key     String   @unique
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  targetType String
  targetId   String?
  meta       Json
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
  @@index([action])
  @@index([targetType, targetId, createdAt])
}
