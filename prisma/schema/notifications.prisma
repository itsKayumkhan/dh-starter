model Notification {
  id        String    @id @default(cuid())
  userId    String
  broadcastId String?
  type      String
  title     String
  body      String
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@unique([broadcastId, userId])
}

model NotificationBroadcast {
  id           String   @id @db.Uuid
  actorId      String
  payloadHash  String
  recipientIds String[]
  createdAt    DateTime @default(now())
}
