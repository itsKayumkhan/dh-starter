# PostgreSQL TCP connection string
DATABASE_URL="postgres://postgres:postgres@localhost:5433/dh_starter?sslmode=disable"
# Unique signing secret, at least 32 characters
BETTER_AUTH_SECRET="replace-with-a-random-secret-at-least-32-characters"
# Public auth origin
BETTER_AUTH_URL="http://localhost:3000"
# Number of trusted ingress proxies that append to X-Forwarded-For; zero shares one fallback rate-limit key
TRUSTED_PROXY_HOPS="0"
# Exact confirmation phrase required with --allow-remote for production or remote seeding
SEED_CONFIRM_REMOTE=""
# Public app origin
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Optional Google OAuth client ID
GOOGLE_CLIENT_ID=""
# Optional Google OAuth client secret
GOOGLE_CLIENT_SECRET=""
# Email transport: console, resend, or smtp
EMAIL_PROVIDER="console"
# Sender identity
EMAIL_FROM="DH Starter <no-reply@dhstarter.test>"
# Resend API key when using Resend
RESEND_API_KEY=""
# SMTP host when using SMTP
SMTP_HOST=""
# SMTP port when using SMTP
SMTP_PORT=""
# SMTP username when using SMTP
SMTP_USER=""
# SMTP password when using SMTP
SMTP_PASS=""
# SMTP TLS toggle when using SMTP
SMTP_SECURE=""

# --- uploads module (Cloudinary) ---
# Cloudinary cloud name
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
# Cloudinary API key
CLOUDINARY_API_KEY=""
# Cloudinary API secret
CLOUDINARY_API_SECRET=""
# Folder prefix per project, e.g. dh-starter
CLOUDINARY_FOLDER_PREFIX="dh-starter"
# Bearer secret for GET /api/uploads/cleanup (at least 32 random characters in production)
UPLOADS_CRON_SECRET=""

# --- billing module (Stripe) ---
# Stripe secret key (sk_test_ in dev)
STRIPE_SECRET_KEY=""
# Stripe webhook signing secret (whsec_)
STRIPE_WEBHOOK_SECRET=""

# --- contact module ---
# Inbox that receives inquiries (falls back to site supportEmail)
CONTACT_NOTIFY_EMAIL=""
# Set to 1 to let the contact e2e spec send through the configured email provider
CONTACT_E2E_DELIVERY=""
